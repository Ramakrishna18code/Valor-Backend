# Local development server
PORT=8081
SPRING_PROFILES_ACTIVE=dev

# MySQL connection settings
DB_URL=jdbc:mysql://localhost:3306/valor_world_dev?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=YOUR_LOCAL_MYSQL_ROOT_PASSWORD

# Application settings
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_LOCAL_SECRET
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8090,http://127.0.0.1:8090
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Local-only bootstrap for the dev profile.
DEV_BOOTSTRAP_ENABLED=true
DEV_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@valor.local
DEV_BOOTSTRAP_SUPER_ADMIN_PASSWORD=YOUR_LOCAL_SUPER_ADMIN_PASSWORD

# Optional local-only sample data for non-empty Admin/Customer/Technician UI.
DEV_SEED_SAMPLE_DATA_ENABLED=false
DEV_SEED_SAMPLE_PASSWORD=YOUR_LOCAL_SAMPLE_USER_PASSWORD
